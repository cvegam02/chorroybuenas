{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": "../..",
    "paths": {
      "https://esm.sh/@supabase/supabase-js@2.39.3": ["node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["deno-shim.d.ts", "_shared/**/*.ts", "*/index.ts"]
}
