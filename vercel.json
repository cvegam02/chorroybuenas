{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run verify && npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/temporada", "destination": "/tematicas", "permanent": true },
    { "source": "/temporada/:id", "destination": "/tematicas/:id", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/shell.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
